{
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/.next",
    "framework": "nextjs",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://goed-hackathon-backend.vercel.app/api/:path*"
        },
        {
            "source": "/_/backend/:path*",
            "destination": "https://goed-hackathon-backend.vercel.app/:path*"
        }
    ]
}